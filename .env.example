# =============================================================================
# ARARAS MT — exemplo de ambiente
# Copie para .env e preencha com credenciais reais. NÃO versione o .env.
# =============================================================================

# ---- Base ÚNICA operacional (Postgres no Docker) ----
POSTGRES_DB=sis_clima_saude
POSTGRES_USER=sisclima
POSTGRES_PASSWORD=sisclima_trocar
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://sisclima:sisclima_trocar@localhost:5432/sis_clima_saude
SIVEP_USE_UNIFIED_DB=true

# Dentro dos containers o compose sobrescreve DATABASE_URL para host "db".

# ---- Data Warehouse SES/MT (leitura) ----
# Mesmo host/DB dos projetos Meningites e Ondas de calor (CIEVS-MT).
# Credenciais NÃO ficam no Git — use .env local ou DW_ENV_FILE apontando
# para o .env de outro projeto CIEVS na mesma máquina/VPN.
USE_SQLSERVER=true
DW_CLIENT=auto
# Linux (cloud/Docker): prefira pymssql se ODBC 18 não estiver instalado.
# DW_CLIENT=pymssql
DW_SERVER=10.15.1.50
DW_HOST=10.15.1.50
DW_PORT=1433
DW_DATABASE=Datawarehouse
DW_USER=menandes_cievs
DW_PASSWORD=
DW_DRIVER=ODBC Driver 18 for SQL Server
DW_ENCRYPT=no
DW_TRUST_SERVER_CERTIFICATE=yes
DW_QUERY_TIMEOUT_SECONDS=120
# Opcional: reutilizar .env de Ondas de calor / Meningites
# DW_ENV_FILE=C:\Users\Menandesneto\OneDrive\CIEVS MT\Monitoramento ondas de calor\.env

# Fontes DW (true/false)
USE_DW_SINAN=true
USE_DW_SIM=true
USE_DW_GAL=true
USE_DW_INDICASUS=true
USE_DW_CNES=true
# API pública CNES (UF 51). Vazio = URL padrão Dados Abertos MS.
# CNES_GEO_API_URL=https://apidadosabertos.saude.gov.br/cnes/estabelecimentos
# Trajeto viário (OSRM). Default no Compose: false — OSRM público trava a ETL (~12k rotas).
# Só ligue com OSRM interno SES (ou aceite tempo longo).
COBERTURA_USAR_TRAJETO=false
# OSRM_URL=https://router.project-osrm.org


# ---- IndicaSUS / BdSES (ocupação tempo real) ----
# Host BdSES (não é o DW). Na produção, o servidor SES alcança o host na rede interna.
# Conta: usuário individual emitido pela STI (ex.: menandesneto), não compartilhar senha no Git.
INDICASUS_HOST=10.15.0.222
INDICASUS_PORT=1433
INDICASUS_DATABASE=BdSES
INDICASUS_USER=
INDICASUS_PASSWORD=
INDICASUS_USE_DW_CREDENTIALS=false
USE_INDICASUS_OCCUPANCY_SCRIPT=true
# Se BdSES estiver inacessível/login falhar, usa último CSV conhecido (fonte marcada como CACHE).
INDICASUS_ALLOW_CSV_FALLBACK=true

# ---- SISREG / Central de Regulação (SQL Server SES) ----
# Mesmas credenciais usadas no projeto Monitoramento ondas de calor (V16).
# SISREG / Central de Regulação (SQL Server SES) — rede interna no servidor de produção.
SISREG_HOST=10.15.1.71
SISREG_PORT=1433
SISREG_DATABASE=SES
SISREG_USER=sisreg_sureg
SISREG_PASSWORD=
# SISREG_SCHEMA=dbo

USE_OPENMETEO=true
REFRESH_OPENMETEO=true
USE_COPERNICUS=false
# Sem chave CAMS: PM2,5/IQA vêm do Open-Meteo Air Quality.
USE_OPENMETEO_AQ=true
OPENMETEO_AQ_PAST_DAYS=7
OPENMETEO_PAST_DAYS=7
OPENMETEO_SSL_VERIFY=true
HTTP_RETRY=3
OPENMETEO_BATCH_SIZE=20
OPENMETEO_AQ_BATCH_SIZE=8
OPENMETEO_PAUSE_S=0.35
USE_INMET=false
# Endpoint JSON de avisos (se vazio, usa RSS Alert-AS: apiprevmet3.inmet.gov.br/avisos/rss).
# INMET_ALERTS_URL=
# INMET_RSS_URL=https://apiprevmet3.inmet.gov.br/avisos/rss
# INMET_UF=MT
# INMET_SSL_VERIFY=false
USE_CEMADEN=true
CEMADEN_ALERTS_URL=https://painelalertas.cemaden.gov.br/wsAlertas2
CEMADEN_UF=MT
CEMADEN_SSL_VERIFY=true
# Focos de queimadas INPE (CSV diário aberto) — agrega 24h/7d por município MT
USE_INPE_QUEIMADAS=true
# WASH AdaptaSUS via IBGE Censo 2022 (água/esgoto domiciliar)
USE_IBGE_WASH=true
REFRESH_IBGE_WASH=false
# Demografia IBGE (Censo 2022) para vulnerabilidade × exposição — force refresh da API
REFRESH_IBGE_VULNERABILIDADE=false
INPE_QUEIMADAS_DAYS=7
# INPE_QUEIMADAS_BASE_URL=https://dataserver-coids.inpe.br/queimadas/queimadas/focos/csv/diario/Brasil
INPE_QUEIMADAS_SSL_VERIFY=true
USE_ANA=true
ANA_UF=MT
ANA_FETCH_SERIES=true
ANA_MAX_ESTACOES=35
ANA_SERIES_DAYS=21
ANA_SSL_VERIFY=true
# Cotas absolutas opcionais: config/ana_cotas_referencia_mt.csv
# ANA_COTAS_REFERENCIA_CSV=config/ana_cotas_referencia_mt.csv
ANA_CHUVA_AMARELA_MM=30
ANA_CHUVA_LARANJA_MM=50
ANA_CHUVA_VERMELHA_MM=80
USE_SIVEP_LOCAL=true
# Se data/input/sivep_atualizacao estiver vazia, tenta sql/sivep_srag_residencia.sql no DW.
USE_DW_SIVEP=true
MUNICIPIOS_SOURCE=ibge
# Universo oficial IBGE-MT (142, incl. Boa Esperança do Norte).
MT_MUNICIPIOS_OFICIAIS=142
# Pasta dos CSVs tratados do Vigibarragens (não versionar GeoJSON).
# VIGIBARRAGENS_DATA_DIR=C:/Users/Menandesneto/OneDrive/Projeto VSR/barragens-mt/dados/tratados

# ---- Automação da ETL (servidor Docker) ----
# Extração completa (replace das tabelas) no máximo 1× por dia civil local.
# Intervalo 24 h; reinício do container não refaz a carga se já houve success hoje.
ETL_INTERVAL_HOURS=24
ETL_RETRY_MINUTES=15
ETL_RUN_ON_START=true
ETL_FULL_ONCE_PER_DAY=true
# Horário local preferido para a próxima janela após sucesso do dia (0–23).
ETL_DAILY_HOUR=6
# ETL_FORCE=true  # força nova extração completa no mesmo dia
ETL_HEALTH_FILE=logs/etl_scheduler_health.json
ETL_LOCK_FILE=logs/etl_scheduler.lock
# O agendador de alertas só comunica após uma ETL bem-sucedida e recente.
ALERT_REQUIRE_FRESH_ETL=true
ALERT_MAX_ETL_AGE_HOURS=30

# ---- Série histórica incremental (clima + saúde) ----
# Snapshot operacional continua replace 1×/dia; hist_* acumula por (cod_ibge, data).
HIST_INCREMENTAL_ENABLED=true
HIST_BOOTSTRAP_ON_EMPTY=true
HIST_LOOKBACK_DAYS=14

# ---- Alertas operacionais (SOP CIEVS) ----
# 1) Deixe false em teste. 2) Configure canais. 3) Valide prévia no painel (Operação → Alertas).
# 4) Só então true. 5) Audite alertas_enviados. 6) Volte a false se necessário.
SEND_ALERT_ON_LEVEL_CHANGE=false
# Fan-out territorial (regionais/municípios): exige planilha + flag true.
# Modelo: config/contatos_alertas.exemplo.csv → data/input/contatos_alertas.csv
ALERT_FANOUT_ENABLED=false
# ALERT_CONTACTS_CSV=data/input/contatos_alertas.csv
# Canal central (ALERT_EMAIL_TO / TELEGRAM_CHAT_ID) recebe só o alerta estadual.
STREAMLIT_PORT=8501

# Agendador diário (Telegram + e-mail) — docker compose service alerts-scheduler
# Roda no servidor/host com Docker (restart: unless-stopped) — NÃO depende do notebook ligado.
# ALERT_INTERVAL_HOURS=24
# ALERT_DIGEST_COOLDOWN_HOURS=20
# ALERT_MIN_LEVEL=laranja
# ALERT_SEND_ON_START=false
# ALERT_DIGEST_SKIP_IDENTICO=true
#
# Roteamento:
# - Canal central (ALERT_EMAIL_TO + TELEGRAM_CHAT_ID) = SOMENTE alerta estadual (SES/CIEVS).
# - Regionais / municipais / Cuiabá: gerados e gravados em alertas_multinivel_v1;
#   envio aos destinatários só com planilha + ALERT_FANOUT_ENABLED=true.
# ALERT_CENTRAL_ONLY_SES=true
# ALERT_FANOUT_ENABLED=false
# ALERT_CONTACTS_CSV=data/input/contatos_alertas.csv
# (modelo: config/contatos_alertas.exemplo.csv — copiar para data/input/contatos_alertas.csv e preencher)
#
# Camadas geradas (persistência). Envio central continua só SES.
# ALERT_LAYERS=ses,regionais,municipais,cuiaba
# ALERT_SES_TOP_MUNICIPIOS=8
# ALERT_REGIONAL_TOP_MUNICIPIOS=8
# ALERT_MAX_REGIONAIS=20
# ALERT_MAX_MUNICIPIOS=12
# ALERT_MIN_LEVEL_MUNICIPAL=laranja
# ALERT_SEND_ALL_MUNICIPIOS=false
# Teste pontual: inclui o IBGE mesmo abaixo do mínimo / fora do top N.
# ALERT_FORCE_MUNICIPIOS=5107925
# USE_AI_ALERT_TEXT=false

# ---- Alertas (canais centrais CIEVS) ----
ALERT_EMAIL_ENABLED=false
ALERT_TELEGRAM_ENABLED=false
ALERT_WEBHOOK_ENABLED=false
# Proxy SES com certificado próprio: TELEGRAM_SSL_VERIFY=false (ou ALERT_SSL_VERIFY=false)
# TELEGRAM_SSL_VERIFY=true
# SMTP Notifica: Gmail (primário) funciona com a senha atual; Titan fica como fallback.
# Porta 465 + SSL. Não use STARTTLS nesta porta.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SSL=1
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# SMTP_FALLBACK_HOST=smtp.titan.email
# SMTP_FALLBACK_PORT=465
# Destinatários do ALERTA ESTADUAL (ex.: você + notifica CIEVS)
# ALERT_EMAIL_TO=menandes@exemplo.gov.br,notifica@ses.mt.gov.br
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# WEBHOOK_URL=

# HidroWeb REST (credenciais pessoais — só no .env local, NÃO versionar)
ANA_USE_HIDROWEB_REST=false
# ANA_HIDROWEB_BASE_URL=https://www.ana.gov.br/hidrowebservice
# ANA_HIDROWEB_IDENTIFICADOR=
# ANA_HIDROWEB_SENHA=
# Token gerado sob demanda (expira ~60 min); opcional se o código renovar sozinho
# ANA_HIDROWEB_TOKEN=

# ---- Painel público / acesso restrito ----
# Primeiro administrador (criado só se o e-mail ainda não existir). NÃO versione senha real.
ARARAS_ADMIN_EMAIL=sti@ses.mt.gov.br
ARARAS_ADMIN_PASSWORD=
ARARAS_ADMIN_NOME=Administrador CIEVS
# Prévia ?interno=1: SOMENTE localhost + esta flag. Nunca ligar em produção/Cloud/LAN.
ARARAS_ALLOW_LOCAL_PREVIEW=false
# OIDC STI: auto-ativar nível SES (default false = exige aprovação CIEVS).
# STI_OIDC_AUTO_SES=false
