# SIS Clima-Saúde MT — configuração de produção
# Copie para .env e preencha (não versionar .env)

RUN_MODE=production
DATABASE_URL=sqlite:///data/output/sis_integrado.db

# Território
MUNICIPIOS_SOURCE=ibge
REFRESH_IBGE_MUNICIPIOS=true
MUNICIPIOS_CSV=data/input/municipios_mt.csv
POPULACAO_CSV=data/input/populacao_municipal_mt_2020_2025.csv
SHAPEFILE_MT=data/geo/municipios_mt/MT_Municipios_2025.shp

# APIs públicas
USE_OPENMETEO=true
REFRESH_OPENMETEO=true
OPENMETEO_MAX_MUNICIPIOS=
USE_INMET=true
INMET_ALERTS_URL=

# Copernicus / qualidade do ar
USE_COPERNICUS=false
COPERNICUS_KEY=
COPERNICUS_URL=https://ads.atmosphere.copernicus.eu/api

# Data Warehouse SES/MT (requer VPN)
USE_SQLSERVER=true
DW_SERVER=
DW_DATABASE=
DW_USER=
DW_PASSWORD=
DW_DRIVER=ODBC Driver 18 for SQL Server
DW_TRUST_SERVER_CERTIFICATE=true
DW_QUERY_TIMEOUT_SECONDS=300

# SIVEP local
USE_SIVEP_LOCAL=true
SIVEP_UPDATE_FOLDER=data/input/sivep_atualizacao
SIVEP_LOCAL_DB_PATH=data/local/sivep/sivep_srag_local.db

# Alertas (opcional)
SEND_ALERT_ON_LEVEL_CHANGE=false
ALERT_EMAIL_ENABLED=false
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
ALERT_TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
