# Copie este conteúdo para o painel de Secrets do Streamlit Cloud.
# Não commitar secrets.toml real no GitHub.

# Opcional no Cloud: se omitir, o app usa data/cloud/sis_cloud_seed.db (snapshot).
# Para dados ao vivo, use Postgres acessível na internet (Neon/Supabase/Railway).
# DATABASE_URL = "postgresql+psycopg2://USER:SENHA@HOST:5432/sis_clima_saude"

USE_EMAIL = "false"
USE_TELEGRAM = "false"
SEND_ALERT_ON_LEVEL_CHANGE = "false"

# SMTP_HOST = "smtp.gmail.com"
