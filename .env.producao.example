# =============================================================================
# ARARAS MT — modelo de ambiente PRODUÇÃO (servidor SES)
# Copie para .env no servidor e preencha. NÃO versione o .env preenchido.
# Ver: docs/STI_IMPLANTACAO_SERVIDOR_SES.md
# =============================================================================

# ---- Postgres (base única operacional) ----
POSTGRES_DB=sis_clima_saude
POSTGRES_USER=sisclima
POSTGRES_PASSWORD=ALTERAR_SENHA_FORTE
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://sisclima:ALTERAR_SENHA_FORTE@localhost:5432/sis_clima_saude
SIVEP_USE_UNIFIED_DB=true

# ---- Contas de serviço SQL Server (somente leitura) ----
USE_SQLSERVER=true
DW_CLIENT=auto
DW_HOST=10.15.1.50
DW_SERVER=10.15.1.50
DW_PORT=1433
DW_DATABASE=Datawarehouse
DW_USER=CONTA_SERVICO_DW
DW_PASSWORD=
DW_DRIVER=ODBC Driver 18 for SQL Server
DW_ENCRYPT=no
DW_TRUST_SERVER_CERTIFICATE=yes
USE_DW_SINAN=true
USE_DW_SIM=true
USE_DW_GAL=true
USE_DW_INDICASUS=true
USE_DW_CNES=true

INDICASUS_HOST=10.15.0.222
INDICASUS_DATABASE=BdSES
INDICASUS_USER=CONTA_SERVICO_INDICASUS
INDICASUS_PASSWORD=
INDICASUS_USE_DW_CREDENTIALS=false
USE_INDICASUS_OCCUPANCY_SCRIPT=true
INDICASUS_ALLOW_CSV_FALLBACK=true

SISREG_HOST=10.15.1.71
SISREG_PORT=1433
SISREG_DATABASE=SES
SISREG_USER=CONTA_SERVICO_SISREG
SISREG_PASSWORD=

# ---- e-SUS APS / Centralizador (Postgres SES, somente leitura) ----
# Distinto de DATABASE_URL (Postgres operacional ARARAS). Host na rede interna SES.
USE_ESUS_APS=true
ESUS_APS_HOST=10.15.0.25
ESUS_APS_PORT=5432
ESUS_APS_DATABASE=esus2
ESUS_APS_USER=
ESUS_APS_PASSWORD=
ESUS_APS_SSLMODE=disable
ESUS_APS_CONNECT_TIMEOUT=15
ESUS_APS_QUERY_TIMEOUT_SECONDS=120
# ESUS_APS_SCHEMA=public

# ---- Fontes públicas ----
USE_OPENMETEO=true
REFRESH_OPENMETEO=true
OPENMETEO_AQ_PAST_DAYS=7
USE_CEMADEN=true
CEMADEN_ALERTS_URL=https://painelalertas.cemaden.gov.br/wsAlertas2
CEMADEN_UF=MT
CEMADEN_SSL_VERIFY=true
USE_INPE_QUEIMADAS=true
USE_IBGE_WASH=true
USE_ANA=true
ANA_UF=MT
ANA_FETCH_SERIES=true
ANA_MAX_ESTACOES=35
ANA_SERIES_DAYS=21
ANA_SSL_VERIFY=true
ANA_USE_HIDROWEB_REST=true
# ANA_HIDROWEB_IDENTIFICADOR=
# ANA_HIDROWEB_SENHA=
USE_COPERNICUS=false
USE_INMET=false
USE_SIVEP_LOCAL=true

# ---- Automação da ETL ----
ETL_INTERVAL_HOURS=24
ETL_RETRY_MINUTES=15
ETL_RUN_ON_START=true
ETL_FULL_ONCE_PER_DAY=true
ETL_DAILY_HOUR=6
ETL_HEALTH_FILE=logs/etl_scheduler_health.json
ETL_LOCK_FILE=logs/etl_scheduler.lock
# Bloqueia comunicação se a última ETL falhou, não existe ou tem mais de ~30 h (carga 1×/dia).
ALERT_REQUIRE_FRESH_ETL=true
ALERT_MAX_ETL_AGE_HOURS=30

# ---- Painel / alertas ----
STREAMLIT_PORT=8501
SEND_ALERT_ON_LEVEL_CHANGE=false
ALERT_FANOUT_ENABLED=false
ALERT_EMAIL_ENABLED=false
ALERT_TELEGRAM_ENABLED=false
ALERT_INTERVAL_HOURS=24
ALERT_DIGEST_COOLDOWN_HOURS=20
ALERT_MIN_LEVEL=laranja

# ---- Painel público / acesso restrito ----
# Primeiro administrador (criado só se o e-mail ainda não existir). NÃO versione senha real.
ARARAS_ADMIN_EMAIL=sti@ses.mt.gov.br
ARARAS_ADMIN_PASSWORD=
ARARAS_ADMIN_NOME=Administrador CIEVS
ARARAS_ALLOW_LOCAL_PREVIEW=false
# STI_OIDC_AUTO_SES=false
