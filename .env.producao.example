# ============================================================
# SIS Clima-Saúde MT — modelo de .env para produção
# Copie para .env e preencha as senhas/tokens reais:
#   copy .env.producao.example .env
# ============================================================

# ===== GERAL / GATE =====
RUN_MODE=production
RUN_PREFLIGHT=true
DATABASE_URL=sqlite:///data/output/sis_integrado.db
APP_UF=MT
APP_TIMEZONE=America/Cuiaba
APP_MUNICIPIO=Cuiabá
APP_LAT=-15.6014
APP_LON=-56.0979

# ===== TERRITÓRIO (obrigatório) =====
SHAPEFILE_MT=data/geo/municipios_mt/MT_Municipios_2025.shp
MUNICIPIOS_CSV=data/input/municipios_mt.csv
POPULACAO_CSV=data/input/populacao_municipal_mt_2020_2025.csv
MUNICIPIOS_SOURCE=ibge

# ===== SQL SERVER / DW (SIM / SINAN / GAL / CNES / SIH via Datawarehouse) =====
# Senha: DW_PASSWORD (sua conta, ex. menandes_cievs)
# SRAG NÃO vem do DW neste fluxo — use SIVEP local (USE_SIVEP_LOCAL).
USE_SQLSERVER=true
USE_DW=true
USE_DW_INDICASUS=true
USE_DW_CNES=true
USE_DW_SINAN=true
USE_DW_SIM=true
USE_DW_GAL=true
USE_DW_SIH=true
# Janela (dias) para agregar SIM/SINAN/SRAG no resumo municipal
EPI_LOOKBACK_DAYS=90

DW_HOST=10.15.1.50
DW_PORT=1433
DW_DATABASE=Datawarehouse
DW_USER=menandes_cievs
# OBRIGATÓRIO: substitua pelo valor real. Se ficar COLE_AQUI_..., o login SQL falha (18456).
DW_PASSWORD=COLE_AQUI_A_SENHA_DW
DW_DRIVER=ODBC Driver 18 for SQL Server
DW_ENCRYPT=no
DW_TRUST_SERVER_CERTIFICATE=yes
DW_QUERY_TIMEOUT_SECONDS=120

# IndicaSUS dedicado (BdSES) — OCUPAÇÃO com usuário Roney
# NÃO use a senha do DW aqui. Mantenha INDICASUS_USE_DW_CREDENTIALS=false.
INDICASUS_HOST=10.15.0.222
INDICASUS_SERVER=10.15.0.222
INDICASUS_PORT=1433
INDICASUS_DATABASE=BdSES
INDICASUS_USER=roneydamaceno
INDICASUS_PASSWORD=COLE_AQUI_A_SENHA_INDICASUS
INDICASUS_SGBD=SQL Server
INDICASUS_ENCRYPT=no
INDICASUS_TRUST_SERVER_CERTIFICATE=yes
INDICASUS_USE_DW_CREDENTIALS=false
USE_INDICASUS_OCCUPANCY_SCRIPT=true

# SISREG — PRESSÃO assistencial (senha própria)
USE_SISREG=true
SISREG_HOST=10.15.1.71
SISREG_SERVER=10.15.1.71
SISREG_PORT=1433
SISREG_DATABASE=SES
SISREG_USER=sisreg_sureg
SISREG_PASSWORD=COLE_AQUI_A_SENHA_SISREG
SISREG_ENCRYPT=no
SISREG_TRUST_SERVER_CERTIFICATE=yes
# Se SISREG falhar, o pipeline usa VW_INTERNACAO no DW (USE_DW_SIH=true).

# ===== SIVEP LOCAL =====
USE_SIVEP_LOCAL=true
SIVEP_LOCAL_DB_PATH=data/local/sivep/sivep_srag_local.db
SIVEP_LOCAL_TABLE=sivep_srag
SIVEP_UPDATE_FOLDER=data/input/sivep_atualizacao
SIVEP_FILE_PATTERN=*.csv;*.parquet;*.xlsx;*.dbf
SIVEP_REBUILD_ON_UPDATE=false

# ===== OPEN-METEO =====
USE_OPENMETEO=true
REFRESH_OPENMETEO=true
OPENMETEO_MAX_MUNICIPIOS=142

# ===== INMET =====
USE_INMET=true
INMET_ALERTS_URL=COLE_AQUI_A_URL_DOS_ALERTAS_INMET

# ===== COPERNICUS / CAMS =====
USE_COPERNICUS=true
COPERNICUS_URL=https://ads.atmosphere.copernicus.eu/api
# Key SEM prefixo UID: (formato novo do ADS). Alternativa: arquivo %USERPROFILE%\.cdsapirc
COPERNICUS_KEY=COLE_AQUI_TOKEN_SEM_UID
COPERNICUS_CAMS_DATASET=cams-global-atmospheric-composition-forecasts
COPERNICUS_FORECAST_TIME=00:00
COPERNICUS_LEADTIME_HOURS=0,3,6,9,12,15,18,21,24,27,30,33,36,39,42,45,48
COPERNICUS_FORMAT=netcdf
COPERNICUS_AREA_NORTH=-7.0
COPERNICUS_AREA_WEST=-62.0
COPERNICUS_AREA_SOUTH=-18.5
COPERNICUS_AREA_EAST=-50.0

# ===== ALERTAS =====
SEND_ALERT_ON_LEVEL_CHANGE=true
# Para testar envio mesmo sem mudança de nível:
# FORCE_ALERT_SEND=true
# Orientação IA nos 3 alertas VIGIA (Estado/Regionais/Cuiabá). Usa GEMINI_API_KEY se houver.
USE_AI_ALERT_TEXT=true
# Em rede SES com proxy SSL self-signed, use:
# ALERT_SSL_VERIFY=false
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# E-mail (seu ambiente usa SSL na porta 465)
USE_EMAIL=true
ALERT_EMAIL_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SSL=true
SMTP_USER=notifica@ses.mt.gov.br
SMTP_FROM=notifica@ses.mt.gov.br
SMTP_PASSWORD=COLE_AQUI_A_SENHA_OU_APP_PASSWORD
EMAIL_TO=menandesneto@gmail.com,notifica@ses.mt.gov.br
EMAIL_DESTINATARIO=menandesneto@gmail.com,notifica@ses.mt.gov.br

# Telegram
USE_TELEGRAM=true
ALERT_TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=COLE_AQUI_O_TOKEN_DO_BOT
TELEGRAM_CHAT_ID=5165574200
TG_CHAT_ID=5165574200

# Webhook (opcional)
ALERT_WEBHOOK_ENABLED=false
WEBHOOK_URL=

# ===== RELATÓRIO IA (opcional) =====
USE_LLM_REPORT=false
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=
GEMINI_API_KEY=

# ===== OUTROS =====
OPENWEATHER_API_KEY=
SIH_DW_SCHEMA=dbo
SIH_DW_TABLE=VW_INTERNACAO
MONITORA_HASH_SALT=
